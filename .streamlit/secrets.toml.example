# Copy to .streamlit/secrets.toml (git-ignored). On Streamlit Community Cloud paste this into App settings -> Secrets.
ANTHROPIC_API_KEY = "<your key>"
# GARANTOVANO_MODEL = "claude-haiku-5-5"   # optional: cheaper/faster than the default claude-opus-5-5

# Default provider is Gemma (Google AI Studio key: aistudio.google.com/apikey)
GEMINI_API_KEY = "<your key>"
# GARANTOVANO_PROVIDER = "anthropic"   # switch back to Claude
# GARANTOVANO_GEMMA_MODEL = "gemini-3.8-flash"   # any model your key lists (gemini-3.5-flash-lite is lighter)
